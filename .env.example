# ==============================================================================
# 🏫 SCHOOL MANAGEMENT SYSTEM - ENVIRONMENT TEMPLATE
# ==============================================================================
# INSTRUCTIONS:
# 1. Copy this template to .env:
#      cp .env.example .env
# 2. On production servers, restrict file permissions immediately:
#      chmod 600 .env
# 3. Replace placeholder values with appropriate configuration or secrets.
# 4. NEVER commit the actual .env file to Git!
# ==============================================================================

# ─── Host Port Binding (Zero Database Exposure) ───────────────────────────────
# IMPORTANT: Never bind database ports to 0.0.0.0. Docker bypasses UFW by default.
# Binds PostgreSQL only to the local loopback interface (127.0.0.1).
POSTGRES_PORT_BINDING=127.0.0.1:5433

# ─── Database (PostgreSQL 16) ─────────────────────────────────────────────────
POSTGRES_DB=school_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_secure_password_here

# ─── Backend API (NestJS) ─────────────────────────────────────────────────────
NODE_ENV=production
PORT=3000
JWT_SECRET=your_jwt_secret_here_change_this

# ─── Database Admin UI (pgAdmin - Optional) ───────────────────────────────────
PGADMIN_EMAIL=admin@cheachanto.edu.kh
PGADMIN_PASSWORD=admin123

# ─── TLS / HTTPS Configuration ────────────────────────────────────────────────
# Path inside host to SSL/TLS certificates:
# (Defaults to generated fallback certificates in ./certs if not using Let's Encrypt / external CA)
TLS_CERT_PATH=./certs/dev-cert.pem
TLS_KEY_PATH=./certs/dev-key.pem
