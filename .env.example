# ─── Database (PostgreSQL) ───────────────────────────────────────────
POSTGRES_DB=school_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_secure_password_here

# ─── NestJS API ───────────────────────────────────────────────────────
NODE_ENV=production
PORT=3000
JWT_SECRET=your_jwt_secret_here_change_this

# ─── pgAdmin (optional) ──────────────────────────────────────────────
PGADMIN_EMAIL=admin@ccc.edu.kh
PGADMIN_PASSWORD=admin123

# ─── TLS / HTTPS Configuration ────────────────────────────────────────
TLS_CERT_PATH=/etc/ssl/certs/cheachantocollege.crt
TLS_KEY_PATH=/etc/ssl/private/cheachantocollege.key

